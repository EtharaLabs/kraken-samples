+                gate = _matrix_to_phxz(u, atol)
+                if gate:
+                    merged_ops.append(gate.on(q))
+            if len(phase_ops) == 1:
+                merged_ops.append(phase_ops[0])
+            elif phase_ops:
+                merged_ops.append(ops.GlobalPhaseGate(phase).on())
+            moments.append(circuits.Moment.from_ops(*merged_ops))
