+        by_qubit.clear()
+        phase_ops.clear()
+        phase = 1 + 0j
+
+    for moment in circuit:
+        if deep:
+            moment = _merge_moment_runs_in_circuit_ops(moment, atol, tags_to_ignore, tags_to_skip)
+        entries = []
+        for op in moment:
+            if not (
+                protocols.num_qubits(op) <= 1
+                and protocols.has_unitary(op)
+                and tags_to_ignore.isdisjoint(op.tags)
+            ):
