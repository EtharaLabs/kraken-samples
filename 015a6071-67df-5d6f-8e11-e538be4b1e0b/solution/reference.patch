+                circuit=_merge_moment_runs(
+                    op_untagged.circuit, atol, tags_to_ignore, True, frozenset()
+                )
+            ).with_tags(*op.tags)
+        new_ops.append(op)
+    return circuits.Moment.from_ops(*new_ops)
 
 
