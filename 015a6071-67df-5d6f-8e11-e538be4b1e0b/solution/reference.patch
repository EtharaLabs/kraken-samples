+    by_qubit: dict[cirq.Qid, list] = {}
+    phase_ops: list[cirq.Operation] = []
+    phase = 1 + 0j
+
+    def flush() -> None:
+        nonlocal phase
+        if len(run) == 1:
+            moments.append(run[0])
