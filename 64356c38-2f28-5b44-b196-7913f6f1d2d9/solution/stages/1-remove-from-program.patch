--- a/pennylane/core/operator/operator2.py
+++ b/pennylane/core/operator/operator2.py
@@ -2011,6 +2011,39 @@
     return old_eqns
 
 
+def _pop_op_eqns_backward(ops: Iterable):
+    """Delete the jaxpr equations of ``ops``, like ``pop_op_eqns``, searching each frame
+    backwards once for all of its targets instead of rebuilding the frame's list per operator.
+    """
+    old_eqns = []
+    targets_by_frame = {}
+
+    for op in ops:
+        if op.tracer is not None:
+            # pylint: disable=protected-access
+            frame = op.tracer._trace.frame
+            assert frame.auto_dce is False  # eqns are stored differently if this is enabled
+
+            eqn = op.tracer.parent
+            old_eqns.append(eqn)
+            targets_by_frame.setdefault(id(frame), (frame, set()))[1].add(id(eqn))
+
+            # delete reference to tracer after its equation has been deleted
+            op.tracer = None
+
+    for frame, targets in targets_by_frame.values():
+        eqns = frame.tracing_eqns
+        for i in reversed(range(len(eqns))):
+            key = id(eqns[i]())
+            if key in targets:
+                targets.discard(key)
+                del eqns[i]
+                if not targets:
+                    break
+
+    return old_eqns
+
+
 def _is_pytree_placeholder(obj) -> bool:
     """Whether 'obj' is a sentinel placeholder that JAX substitutes for real pytree leaves."""
     cls = type(obj)
