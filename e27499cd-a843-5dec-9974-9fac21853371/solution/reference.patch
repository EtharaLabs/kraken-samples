+        score = np.abs(np.asarray(XtA)[candidates])
+        if n_extra < candidates.shape[0]:
+            candidates = candidates[np.argpartition(-score, n_extra - 1)[:n_extra]]
+        ready[candidates] = 1
+        rows = np.concatenate((rows, candidates))
+    fill_rows(rows)
+    return 0
