+    const floating[::1] l1_regs,
+    const floating[::1] l2_regs,
+    const floating[:, ::1] Q,
+    const floating[::1] Q_diag,
+    const floating[::1] q,
+    floating y_norm2,
+    floating[::1] Qw,
+    floating[:, :] coefs,
