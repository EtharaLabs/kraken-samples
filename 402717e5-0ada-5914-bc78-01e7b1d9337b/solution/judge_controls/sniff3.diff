+    def _lstsq_tvalue(self, endog, exog, col):
+        """t-statistic of one coefficient from a least-squares fit."""
+        nobs, k_exog = exog.shape
+        coef, _, rank, _ = np.linalg.lstsq(exog, endog, rcond=None)
+        if rank < k_exog:
+            return self._quick_ols(endog, exog)[col]
+        resid = endog - exog @ coef
+        sigma2 = resid @ resid / (nobs - k_exog)
+        row = np.linalg.pinv(exog)[col]
+        return coef[col] / np.sqrt(sigma2 * (row @ row))
+
