+    def _qr_tvalue(self, endog, exog, col):
+        """
+        t-statistic of one coefficient from a column-pivoted QR fit
+
+        Falls back to ``_quick_ols`` when the pivoted factor is rank deficient,
+        so singular designs behave as before.
+        """
+        nobs, k_exog = exog.shape
+        q, r, piv = qr(exog, mode="economic", pivoting=True)
+        diag = np.abs(np.diag(r))
+        if not np.all(np.isfinite(r)) or diag[-1] <= max(nobs, k_exog) * np.finfo(float).eps * diag[0]:
+            return self._quick_ols(endog, exog)[col]
+        coef = np.empty(k_exog)
+        coef[piv] = solve_triangular(r, q.T @ endog)
+        resid = endog - exog @ coef
+        sigma2 = resid @ resid / (nobs - k_exog)
+        rinv = solve_triangular(r, np.eye(k_exog))
+        pos = int(np.flatnonzero(piv == col)[0])
+        return coef[col] / np.sqrt(sigma2 * (rinv[pos] @ rinv[pos]))
+
