+    def _break_tvalues(
+        self, endog, exog, regression, periods, nobs, const, trend, cols, lags
+    ):
+        nreg = exog.shape[0]
+        nper = periods.shape[0]
+        k = lags + 2
+        m = 2 if regression == "ct" else 1
+        f = periods - (lags + 1)
+        if regression == "t":
+            f = f - 1
+        if (
+            nper == 0
+            or nreg <= k + m + 1
+            or f[0] < 0
+            or f[-1] >= nreg
+        ):
+            return None
+        F = np.empty((nreg, k))
+        F[:, 0] = const
+        F[:, 1] = trend[(lags + 2) : (nobs + 1)]
+        F[:, 2:] = exog[:, cols:]
+        L = exog[:, cols - 1 : cols]
+        tol = np.sqrt(np.finfo(float).eps)
+        res = nested_lag_ols(endog, L, F, rcond=tol)
+        if res is None:
+            return None
+        r = res.r
+
+        data = np.column_stack([F, L, endog]) - res.offset
+        t_ = np.cumsum(data[::-1], axis=0)[::-1]
+        n_ = (nreg - f).astype(float)
+        ncols = data.shape[1]
+        xd = np.empty((ncols, nper, m))
+        dd = np.empty((nper, m, m))
+        if regression != "t":
+            xd[:, :, 0] = t_[f].T
+            dd[:, 0, 0] = n_
+        if regression != "c":
+            xd[:, :, -1] = np.cumsum(t_[::-1], axis=0)[::-1][f].T
+            dd[:, -1, -1] = n_ * (n_ + 1) * (2 * n_ + 1) / 6
+        if regression == "ct":
+            dd[:, 0, 1] = dd[:, 1, 0] = n_ * (n_ + 1) / 2
+
+        c = solve_triangular(r, xd.reshape(ncols, -1), trans="T")
+        c = c.reshape(ncols, nper, m).transpose(1, 0, 2)
+        q = c[:, :k]
+        s = dd - q.transpose(0, 2, 1) @ q
+        ok = s[:, 0, 0] > tol * dd[:, 0, 0]
+        if m == 2:
+            with np.errstate(divide="ignore", invalid="ignore"):
+                pivot = s[:, 1, 1] - s[:, 0, 1] ** 2 / s[:, 0, 0]
+            ok &= pivot > tol * dd[:, 1, 1]
+        if not np.all(ok):
+            return None
+        h = np.linalg.cholesky(s)
+        w = r[k:, k:]
+        v = np.linalg.solve(h, c[:, k:].transpose(0, 2, 1) @ w)
+        g = w.T @ w - v.transpose(0, 2, 1) @ v
+        g0 = g[:, 0, 0]
+        with np.errstate(divide="ignore", invalid="ignore"):
+            z = g[:, 0, 1] / np.sqrt(g0)
+        ssr = g[:, 1, 1] - z**2
+        if not (
+            np.all(g0 > tol * w[0, 0] ** 2)
+            and np.all(ssr > tol * w[1, 1] ** 2)
+        ):
+            return None
+        df_resid = nreg - (k + m + 1)
+        return z / np.sqrt(ssr / df_resid)
+
