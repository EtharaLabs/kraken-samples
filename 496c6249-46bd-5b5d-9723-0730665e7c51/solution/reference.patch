+    string_dtype = None
+    if (ar1.dtype.kind == "T" or ar2.dtype.kind == "T") and (
+            ar1.dtype.kind in "TU" and ar2.dtype.kind in "TU"):
+        try:
+            # promote both operands to one StringDType
+            string_dtype = np.result_type(ar1, ar2)
+        except TypeError:
+            # incompatible missing values (e.g. ar1.na_object is None and
+            # ar2.na_object is np.nan) keep the comparison loop below
+            pass
+    if string_dtype is not None:
+        # Hash the promoted operands in C. The dtype's own comparison rules for
+        # missing values apply: a NaN-like missing value never matches, a string
+        # missing value compares as its string, and any other missing value
+        # matches only a missing value. A cast between equal StringDType
+        # instances still copies, so it is skipped.
+        if ar1.dtype != string_dtype:
+            ar1 = ar1.astype(string_dtype)
+        if ar2.dtype != string_dtype:
+            ar2 = ar2.astype(string_dtype)
+        return string_dtype._isin(ar1, ar2, invert)
+
     # Check if one of the arrays may contain arbitrary objects
