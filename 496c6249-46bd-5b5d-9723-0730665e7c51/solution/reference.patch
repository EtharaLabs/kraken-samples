+/* Hash-based membership for two promoted StringDType arrays (private, used by np.isin). */
+typedef struct {
+    uint64_t hash;
+    size_t size;
+    const char *buf;
+} isin_slot;
+
+static inline uint64_t
+isin_hash(const char *p, size_t n)
+{
+    uint64_t h = 0x9E3779B97F4A7C15ULL ^ (uint64_t)n;
+    while (n >= 8) {
+        uint64_t k;
+        memcpy(&k, p, 8);
+        k *= 0xBF58476D1CE4E5B9ULL;
+        k ^= k >> 31;
+        h = (h ^ k) * 0x94D049BB133111EBULL;
+        p += 8;
+        n -= 8;
+    }
+    if (n) {
+        uint64_t k = 0;
+        memcpy(&k, p, n);
+        k *= 0xBF58476D1CE4E5B9ULL;
+        k ^= k >> 31;
+        h = (h ^ k) * 0x94D049BB133111EBULL;
+    }
+    h ^= h >> 29;
+    return h ? h : 1;
+}
+
+static inline int
+isin_find(isin_slot *table, size_t mask, uint64_t h, const char *buf, size_t size)
+{
+    size_t k = (size_t)h & mask;
+    while (table[k].hash) {
+        if (table[k].hash == h && table[k].size == size &&
+                (size == 0 || memcmp(table[k].buf, buf, size) == 0)) {
+            return 1;
+        }
+        k = (k + 1) & mask;
+    }
+    return 0;
+}
+
+static PyObject *
+stringdtype__isin(PyArray_StringDTypeObject *self, PyObject *args)
+{
+    PyArrayObject *ar1, *ar2;
+    int invert;
+    if (!PyArg_ParseTuple(args, "O!O!p", &PyArray_Type, &ar1, &PyArray_Type, &ar2, &invert)) {
+        return NULL;
+    }
+    if (PyArray_NDIM(ar1) != 1 || PyArray_NDIM(ar2) != 1 ||
+            NPY_DTYPE(PyArray_DESCR(ar1)) != &PyArray_StringDType ||
+            NPY_DTYPE(PyArray_DESCR(ar2)) != &PyArray_StringDType) {
+        PyErr_SetString(PyExc_TypeError, "_isin needs two 1-D StringDType arrays");
+        return NULL;
+    }
+    npy_intp n = PyArray_DIM(ar1, 0), m = PyArray_DIM(ar2, 0);
+    npy_intp dims[1] = {n};
+    PyArrayObject *out = (PyArrayObject *)PyArray_SimpleNew(1, dims, NPY_BOOL);
+    if (out == NULL) {
+        return NULL;
+    }
+    size_t cap = 16;
+    while (cap < (size_t)m * 2 + 1) {
+        cap <<= 1;
+    }
+    isin_slot *table = PyMem_RawCalloc(cap, sizeof(isin_slot));
+    if (table == NULL) {
+        Py_DECREF(out);
+        return PyErr_NoMemory();
+    }
+    int has_null = self->na_object != NULL;
+    int has_nan_na = self->has_nan_na;
+    int has_string_na = self->has_string_na;
+    npy_static_string default_string = self->default_string;
+
+    PyArray_Descr *descrs[2] = {PyArray_DESCR(ar1), PyArray_DESCR(ar2)};
+    npy_string_allocator *allocators[2] = {NULL, NULL};
+    NpyString_acquire_allocators(2, descrs, allocators);
+    int b_has_null = 0, failed = 0;
+    npy_static_string s = {0, NULL};
+    char *data = PyArray_BYTES(ar2);
+    npy_intp stride = PyArray_STRIDE(ar2, 0);
+    for (npy_intp j = 0; j < m; j++, data += stride) {
+        int r = NpyString_load(allocators[1], (npy_packed_static_string *)data, &s);
+        if (r == -1) {
+            failed = 1;
+            break;
+        }
+        if (r == 1) {
+            if (has_nan_na || !has_null) {
+                continue;
+            }
+            if (!has_string_na) {
+                b_has_null = 1;
+                continue;
+            }
+            s = default_string;
+        }
+        uint64_t h = isin_hash(s.buf, s.size);
+        size_t k = (size_t)h & (cap - 1);
+        while (table[k].hash) {
+            if (table[k].hash == h && table[k].size == s.size &&
+                    (s.size == 0 || memcmp(table[k].buf, s.buf, s.size) == 0)) {
+                break;
+            }
+            k = (k + 1) & (cap - 1);
+        }
+        if (!table[k].hash) {
+            table[k].hash = h;
+            table[k].size = s.size;
+            table[k].buf = s.buf;
+        }
+    }
+    npy_bool *o = (npy_bool *)PyArray_DATA(out);
+    data = PyArray_BYTES(ar1);
+    stride = PyArray_STRIDE(ar1, 0);
+    for (npy_intp i = 0; !failed && i < n; i++, data += stride) {
+        int r = NpyString_load(allocators[0], (npy_packed_static_string *)data, &s);
+        int hit;
+        if (r == -1) {
+            failed = 1;
+            break;
+        }
+        if (r == 1 && (has_nan_na || !has_null)) {
+            hit = 0;
+        }
+        else if (r == 1 && !has_string_na) {
+            hit = b_has_null;
+        }
+        else {
+            if (r == 1) {
+                s = default_string;
+            }
+            hit = isin_find(table, cap - 1, isin_hash(s.buf, s.size), s.buf, s.size);
+        }
+        o[i] = (npy_bool)(hit != invert);
+    }
+    NpyString_release_allocators(2, allocators);
+    PyMem_RawFree(table);
+    if (failed) {
+        Py_DECREF(out);
+        PyErr_SetString(PyExc_MemoryError, "Failed to load string in StringDType _isin");
+        return NULL;
+    }
+    return (PyObject *)out;
+}
